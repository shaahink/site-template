# ── sk baseline ──────────────────────────────────────────────────────────
# Identical in every site under the sk credit line. See shaahink/drydock.

# Secrets. `vercel link` writes .env.local, so this rule has to exist before
# anyone runs it. `.dev.vars` is the same file for Cloudflare Pages and is not
# matched by `.env*` — found in session 9.5 by writing one and watching
# `git status` offer to commit it.
.env*
!.env.example
.dev.vars*

# Dependencies and build output
node_modules/
dist/
build/
.astro/
.output/

# Host tooling
.vercel
.wrangler/

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
